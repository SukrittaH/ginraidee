# Vault Configuration Example
# Copy this to your service's .env file and update values

# ===== VAULT CONFIGURATION =====

# Enable/disable Vault secrets management
# true  = Load secrets from Vault (with .env fallback)
# false = Use .env files only (default)
VAULT_ENABLED=false

# Vault provider type
# - hashicorp: HashiCorp Vault (local development)
# - azure: Azure Key Vault (production)
VAULT_TYPE=hashicorp

# ===== HASHICORP VAULT (Local Development) =====
# Only needed if VAULT_TYPE=hashicorp

# Vault server address
# Docker: http://vault:8200
# Local: http://localhost:8200
VAULT_ADDR=http://vault:8200

# Vault authentication token
# Dev mode default: dev-root-token
# Production: Use AppRole or other auth method
VAULT_TOKEN=dev-root-token

# ===== AZURE KEY VAULT (Production) =====
# Only needed if VAULT_TYPE=azure

# Azure Key Vault URL
# Format: https://{vault-name}.vault.azure.net/
AZURE_KEYVAULT_URL=https://your-vault-name.vault.azure.net/

# Note: Azure uses Managed Identity for authentication
# No credentials needed in production

# ===== CONFIGURATION EXAMPLES =====

# Example 1: Local development with Vault
# VAULT_ENABLED=true
# VAULT_TYPE=hashicorp
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=dev-root-token

# Example 2: Production with Azure Key Vault
# VAULT_ENABLED=true
# VAULT_TYPE=azure
# AZURE_KEYVAULT_URL=https://ginraidee-vault.vault.azure.net/

# Example 3: Traditional .env only (no Vault)
# VAULT_ENABLED=false
# JWT_SECRET=your-jwt-secret
# ENTRAID_CLIENT_ID=your-client-id
# ... other secrets

# ===== FALLBACK SECRETS (.env) =====
# These are used if:
# 1. VAULT_ENABLED=false
# 2. Vault is unavailable
# 3. Secret not found in Vault

# Keep your existing .env configuration as backup
# Example:
# JWT_SECRET=dev-secret-key-change-in-production
# ENTRAID_CLIENT_ID=fn384-cjjnfkj0-3rio3uf-jnfjkenr
# AZURE_OPENAI_API_KEY=your-key-here
