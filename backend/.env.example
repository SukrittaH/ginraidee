# Backend Environment Configuration
# ============================================
# For local development:
#   1. Copy this file to .env
#   2. Change NODE_ENV to 'development'
#   3. Use DATABASE_URL with local PostgreSQL
#   4. Add your EntraID app registration credentials
#
# For Azure production:
#   1. Copy this file to .env
#   2. Change NODE_ENV to 'production'
#   3. Use POSTGRES_CONNECTION_STRING with Azure PostgreSQL
#   4. Add your EntraID app registration credentials
#   5. Add your Azure domain to CORS_ORIGINS

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=development

# ===== ENTRAID (AZURE AD) CONFIGURATION =====
# Create app registration in Azure Portal:
# 1. Azure AD > App registrations > New registration
# 2. Name: "Ginraidee Mobile App"
# 3. Supported accounts: "Accounts in any organizational directory and personal Microsoft accounts"
# 4. After creation, get:
#    - Application (client) ID
#    - Directory (tenant) ID
ENTRAID_CLIENT_ID=your_client_id_here
ENTRAID_TENANT_ID=common
ENTRAID_ISSUER=https://login.microsoftonline.com/common/v2.0
ENTRAID_JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys

# ===== AZURE OPENAI CONFIGURATION =====
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# ===== DATABASE CONFIGURATION =====
# LOCAL DEVELOPMENT (PostgreSQL locally)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ginraidee

# OR AZURE PRODUCTION (Azure PostgreSQL)
# Generate URL format: postgresql://username@servername:password@servername.postgres.database.azure.com:5432/ginraidee?sslmode=require
# Note: Special characters in password must be URL-encoded (e.g., / becomes %2F, < becomes %3C)
# POSTGRES_CONNECTION_STRING=postgresql://pgadmin:password%40encoding@server.postgres.database.azure.com:5432/ginraidee?sslmode=require

# ===== CORS CONFIGURATION =====
# Local Development Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:3000,exp://localhost:8081,exp://10.0.2.2:8081

# Production Origins (Azure)
# CORS_ORIGINS=https://ginraidee-api.azurewebsites.net,https://ginraidee.azurewebsites.net

# ===== AZURE DOCUMENT INTELLIGENCE (OCR) =====
# Better OCR than Computer Vision, better for structured documents
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_key_here
