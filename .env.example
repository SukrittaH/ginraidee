# Frontend Environment Variables
# This is a template file. For actual configuration:
# - Local development: Use .env.local (copy from .env.local.example)
# - Production (Azure): Use .env.production (copy from .env.production.example)

# API Configuration
REACT_APP_API_BASE_URL=https://your-resource.azurewebsites.net/api

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-chat
