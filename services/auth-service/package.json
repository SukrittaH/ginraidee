{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication and user profile service for Ginraidee",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit --coverage",
    "test:integration": "jest --selectProjects integration --coverage --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [
    "auth",
    "jwt",
    "entra",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "morgan": "^1.10.0",
    "node-vault": "^0.12.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.0",
    "jest": "^29.7.0",
    "nock": "^13.5.0",
    "nodemon": "^3.0.2",
    "sequelize-mock": "^0.10.2",
    "sqlite3": "^6.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
